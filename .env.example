# Node 24+. Local SQLite state is retained in this directory.
PORT=3001
DATA_DIR=./data
# In development use the Vite origin; in production use your HTTPS domain.
APP_URL=http://localhost:5173
NODE_ENV=development
# Set to 1 only when deployed behind one trusted reverse proxy.
TRUST_PROXY=0
# Free hosted preview only: disable payments and display a temporary-data notice.
NEATQUOTE_PREVIEW=0
# Optional for local development. Use sandbox merchant credentials for testing.
# Production requires an approved iyzico merchant account and live keys.
IYZIPAY_API_KEY=
IYZIPAY_SECRET_KEY=
IYZIPAY_URI=https://sandbox-api.iyzipay.com
