    "postman-request": { "uuid": "11.1.1" }
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
